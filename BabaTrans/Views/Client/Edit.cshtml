@model BabaTrans.Models.Client
@{
    ViewData["Title"] = "Modifier le Supermarché";
    var estAdmin = User.IsInRole("Administrateur");
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="bt-card fade-in">
            <div class="bt-card-header">
                <h5><i class="bi bi-pencil-square text-primary me-2"></i>Modifier @Model.NomSupermarche</h5>
                <a asp-action="Details" asp-route-id="@Model.Id" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-arrow-left"></i> Retour</a>
            </div>
            <div class="bt-card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="bt-alert bt-alert-danger mb-4"></div>

                    <div class="row g-3">
                        <partial name="_Formulaire" model="Model" />

                        <div class="col-md-6">
                            <label asp-for="EstActif" class="bt-form-label">Statut</label>
                            @if (estAdmin)
                            {
                                <select asp-for="EstActif" class="bt-form-control">
                                    <option value="true">Actif</option>
                                    <option value="false">Inactif</option>
                                </select>
                            }
                            else
                            {
                                <input type="hidden" asp-for="EstActif" />
                                <div class="pt-2">
                                    <span class="bt-badge @(Model.EstActif ? "bt-badge-accent" : "bt-badge-danger")">@(Model.EstActif ? "Actif" : "Inactif")</span>
                                </div>
                                <div class="bt-form-hint">Seul un administrateur peut changer le statut.</div>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="bt-btn bt-btn-outline">Annuler</a>
                        <button type="submit" class="bt-btn bt-btn-primary">
                            <i class="bi bi-check-lg"></i> Enregistrer les modifications
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
