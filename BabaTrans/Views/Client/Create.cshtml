@model BabaTrans.Models.Client
@{
    ViewData["Title"] = "Nouveau Supermarché";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="bt-card fade-in">
            <div class="bt-card-header">
                <h5><i class="bi bi-shop-window text-primary me-2"></i>Enregistrer un Supermarché</h5>
                <a asp-action="Index" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-arrow-left"></i> Retour</a>
            </div>
            <div class="bt-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="bt-alert bt-alert-danger mb-4"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="NomSupermarche" class="bt-form-label"></label>
                            <input asp-for="NomSupermarche" class="bt-form-control" placeholder="Ex: Kin Marché, Shoprite Gombe, SK Hypermarket" />
                            <span asp-validation-for="NomSupermarche" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telephone" class="bt-form-label"></label>
                            <input asp-for="Telephone" class="bt-form-control" placeholder="+243 81 234 5678" />
                            <span asp-validation-for="Telephone" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="bt-form-label"></label>
                            <input asp-for="Email" class="bt-form-control" placeholder="contact@supermarche.cd" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PersonneContact" class="bt-form-label"></label>
                            <input asp-for="PersonneContact" class="bt-form-control" placeholder="Nom du responsable logistique" />
                            <span asp-validation-for="PersonneContact" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Adresse" class="bt-form-label"></label>
                            <textarea asp-for="Adresse" class="bt-form-control" rows="3" placeholder="Adresse physique, commune, ville (ex: Boulevard du 30 Juin, Gombe, Kinshasa)"></textarea>
                            <span asp-validation-for="Adresse" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top border-secondary-subtle">
                        <a asp-action="Index" class="bt-btn bt-btn-outline">Annuler</a>
                        <button type="submit" class="bt-btn bt-btn-primary">
                            <i class="bi bi-save"></i> Enregistrer le Supermarché
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
