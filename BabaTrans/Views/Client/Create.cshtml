@model BabaTrans.Models.Client
@{
    ViewData["Title"] = "Nouveau Supermarché";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="bt-card fade-in">
            <div class="bt-card-header">
                <h5><i class="bi bi-shop-window text-primary me-2"></i>Enregistrer un supermarché</h5>
                <a asp-action="Index" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-arrow-left"></i> Retour</a>
            </div>
            <div class="bt-card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="bt-alert bt-alert-danger mb-4"></div>

                    <div class="row g-3">
                        <partial name="_Formulaire" model="Model" />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="bt-btn bt-btn-outline">Annuler</a>
                        <button type="submit" class="bt-btn bt-btn-primary">
                            <i class="bi bi-save"></i> Enregistrer le supermarché
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_CarteScripts" />
}
