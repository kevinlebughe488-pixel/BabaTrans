@model BabaTrans.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Nouvel Utilisateur";
    var emailsSupermarches = ViewBag.EmailsSupermarches as List<SelectListItem> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="bt-card fade-in">
            <div class="bt-card-header">
                <div>
                    <h5><i class="bi bi-person-plus-fill me-2 text-primary"></i>Créer un compte utilisateur</h5>
                    <small class="text-muted">Le rôle définit les droits d'accès dans l'application</small>
                </div>
                <a asp-action="Users" class="bt-btn bt-btn-outline bt-btn-sm">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>
            </div>
            <div class="bt-card-body">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="bt-alert bt-alert-danger mb-4"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Role" class="bt-form-label"></label>
                            <select asp-for="Role" class="bt-form-control" id="roleSelector">
                                <option value="">-- Sélectionnez un rôle --</option>
                                <option value="Administrateur">Administrateur (accès total et rapports)</option>
                                <option value="Agent">Agent BABA-Trans (commandes, colis, timbres, affectations)</option>
                                <option value="Livreur">Livreur (scans et confirmation de remise)</option>
                                <option value="Client">Client / supermarché (ses commandes et leur suivi)</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Nom" class="bt-form-label"></label>
                            <input asp-for="Nom" class="bt-form-control" placeholder="Nom de famille" />
                            <span asp-validation-for="Nom" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Prenom" class="bt-form-label"></label>
                            <input asp-for="Prenom" class="bt-form-control" placeholder="Prénom" />
                            <span asp-validation-for="Prenom" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Email" class="bt-form-label"></label>
                            <input asp-for="Email" class="bt-form-control" placeholder="nom@babatrans.cd" list="emailsSupermarches" autocomplete="off" />
                            <datalist id="emailsSupermarches">
                                @foreach (var supermarche in emailsSupermarches)
                                {
                                    <option value="@supermarche.Value">@supermarche.Text</option>
                                }
                            </datalist>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <div class="bt-form-hint role-field" id="clientHint" style="display:none;">
                                <i class="bi bi-info-circle me-1"></i>Pour un compte Client, utilisez l'email exact du supermarché enregistré : c'est ce qui relie le compte à ses commandes.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="bt-form-label"></label>
                            <input asp-for="Password" class="bt-form-control" placeholder="6 caractères minimum" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="bt-form-hint">Avec majuscule, minuscule, chiffre et caractère spécial.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="bt-form-label"></label>
                            <input asp-for="ConfirmPassword" class="bt-form-control" placeholder="Confirmer le mot de passe" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 role-field" id="matriculeField" style="display:none;">
                            <label asp-for="Matricule" class="bt-form-label">Matricule agent</label>
                            <input asp-for="Matricule" class="bt-form-control" placeholder="Ex : AGT-2026-009" />
                            <span asp-validation-for="Matricule" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 role-field" id="immatField" style="display:none;">
                            <label asp-for="Immatriculation" class="bt-form-label">Matricule livreur</label>
                            <input asp-for="Immatriculation" class="bt-form-control" placeholder="Ex : LIV-KIN-004" />
                            <span asp-validation-for="Immatriculation" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Users" class="bt-btn bt-btn-outline">Annuler</a>
                        <button type="submit" class="bt-btn bt-btn-primary">
                            <i class="bi bi-check2-circle"></i> Créer l'utilisateur
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const roleSel = document.getElementById('roleSelector');
        const champs = {
            Agent: document.getElementById('matriculeField'),
            Livreur: document.getElementById('immatField'),
            Client: document.getElementById('clientHint')
        };

        function majChamps() {
            Object.entries(champs).forEach(([role, element]) => {
                element.style.display = roleSel.value === role ? 'block' : 'none';
            });
        }

        roleSel.addEventListener('change', majChamps);
        majChamps();
    </script>
}
