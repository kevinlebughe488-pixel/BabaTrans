@{
    ViewData["Title"] = "Accès Refusé";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="bt-card p-5 fade-in">
            <div class="mb-4">
                <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-heading mb-2">Accès non autorisé</h2>
            <p class="text-muted mb-4">
                Votre profil ne dispose pas des droits nécessaires pour accéder à cette page.
                Si vous pensez qu'il s'agit d'une erreur, contactez un administrateur BABA-Trans.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Dashboard" asp-action="Index" class="bt-btn bt-btn-primary">
                    <i class="bi bi-house-door"></i> Retour au tableau de bord
                </a>
            </div>
        </div>
    </div>
</div>
