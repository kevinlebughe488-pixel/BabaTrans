@{
    ViewData["Title"] = "Accès Refusé";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-6 text-center">
        <div class="bt-card p-5 fade-in">
            <div class="mb-4">
                <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
            </div>
            <h2 class="text-white fw-bold mb-2">Accès Non Autorisé (RBAC)</h2>
            <p class="text-muted mb-4">
                Votre profil utilisateur ne dispose pas des privilèges nécessaires pour accéder à cette fonctionnalité selon les politiques de sécurité définies pour BABA-Trans.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Dashboard" asp-action="Index" class="bt-btn bt-btn-primary">
                    <i class="bi bi-house-door"></i> Retour au tableau de bord
                </a>
            </div>
        </div>
    </div>
</div>
