@{
    ViewData["Title"] = "Gestion des Utilisateurs & Rôles";
    var userRoles = ViewBag.UserRoles as List<(BabaTrans.Models.Utilisateur User, IList<string> Roles)> ?? new();
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="bt-page-header">
    <div>
        <h4 class="fw-bold text-heading"><i class="bi bi-people-fill text-primary me-2"></i>Utilisateurs & rôles</h4>
        <div class="text-muted small">Comptes autorisés à se connecter au système</div>
    </div>
    <a asp-action="Register" class="bt-btn bt-btn-primary">
        <i class="bi bi-person-plus-fill"></i> Nouvel utilisateur
    </a>
</div>

<div class="bt-card fade-in">
    <div class="bt-card-body p-0">
        <div class="table-responsive">
            <table class="bt-table">
                <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Matricule</th>
                        <th>Créé le</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (userRoles.Any())
                    {
                        foreach (var item in userRoles)
                        {
                            var role = item.Roles.FirstOrDefault() ?? "Sans rôle";
                            var badgeClass = role switch
                            {
                                "Administrateur" => "bt-badge-danger",
                                "Agent" => "bt-badge-info",
                                "Livreur" => "bt-badge-accent",
                                "Client" => "bt-badge-warning",
                                _ => "bt-badge-neutral"
                            };
                            var estMoi = item.User.Id == currentUserId;

                            <tr class="@(item.User.EstActif ? "" : "opacity-75")">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bt-avatar bt-avatar-sm">
                                            @($"{item.User.Prenom.FirstOrDefault()}{item.User.Nom.FirstOrDefault()}".ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-heading">@item.User.Prenom @item.User.Nom</div>
                                            @if (estMoi)
                                            {
                                                <div class="text-muted small">C'est vous</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>@item.User.Email</td>
                                <td><span class="bt-badge @badgeClass">@role</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.User.Matricule))
                                    {
                                        <span class="bt-code">@item.User.Matricule</span>
                                    }
                                    else if (!string.IsNullOrEmpty(item.User.Immatriculation))
                                    {
                                        <span class="bt-code">@item.User.Immatriculation</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-nowrap">@item.User.DateCreation.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.User.EstActif)
                                    {
                                        <span class="bt-badge bt-badge-accent"><i class="bi bi-check-circle"></i> Actif</span>
                                    }
                                    else
                                    {
                                        <span class="bt-badge bt-badge-danger"><i class="bi bi-x-circle"></i> Inactif</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!estMoi)
                                    {
                                        <form asp-action="ToggleUser" asp-route-id="@item.User.Id" method="post" class="d-inline"
                                              data-confirm="@(item.User.EstActif ? $"Désactiver le compte de {item.User.Prenom} {item.User.Nom} ? Il sera déconnecté." : $"Réactiver le compte de {item.User.Prenom} {item.User.Nom} ?")">
                                            <button type="submit" class="bt-btn bt-btn-outline bt-btn-sm">
                                                @if (item.User.EstActif)
                                                {
                                                    <i class="bi bi-slash-circle text-warning"></i> <span>Désactiver</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check2 text-success"></i> <span>Réactiver</span>
                                                }
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Aucun utilisateur trouvé.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
