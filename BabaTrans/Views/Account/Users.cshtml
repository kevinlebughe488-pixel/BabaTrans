@{
    ViewData["Title"] = "Gestion des Utilisateurs & Rôles";
    var userRoles = ViewBag.UserRoles as List<(BabaTrans.Models.Utilisateur User, IList<string> Roles)>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Contrôle d'Accès & RBAC</h4>
        <div class="text-muted small">Consultez et administrez les comptes autorisés dans le système</div>
    </div>
    <a asp-action="Register" class="bt-btn bt-btn-primary">
        <i class="bi bi-person-plus-fill"></i> Nouvel Utilisateur
    </a>
</div>

<div class="bt-card fade-in">
    <div class="bt-card-body p-0">
        <div class="table-responsive">
            <table class="bt-table">
                <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Email</th>
                        <th>Rôle RBAC</th>
                        <th>Matricule / Réf</th>
                        <th>Date Création</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (userRoles != null && userRoles.Any())
                    {
                        foreach (var item in userRoles)
                        {
                            var role = item.Roles.FirstOrDefault() ?? "Sans rôle";
                            var badgeClass = role switch {
                                "Administrateur" => "bt-badge-danger",
                                "Agent" => "bt-badge-info",
                                "Livreur" => "bt-badge-accent",
                                "Client" => "bt-badge-warning",
                                _ => "bt-badge-primary"
                            };

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="user-avatar" style="width:34px; height:34px; border-radius:8px; background:rgba(79,70,229,0.2); display:flex; align-items:center; justify-content:center; color:var(--bt-primary-light); font-weight:bold;">
                                            @($"{item.User.Prenom?.FirstOrDefault()}{item.User.Nom?.FirstOrDefault()}".ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-white">@item.User.Prenom @item.User.Nom</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.User.Email</td>
                                <td>
                                    <span class="bt-badge @badgeClass">@role</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.User.Matricule))
                                    {
                                        <span class="text-muted small"><i class="bi bi-badge-ad me-1"></i>@item.User.Matricule</span>
                                    }
                                    else if (!string.IsNullOrEmpty(item.User.Immatriculation))
                                    {
                                        <span class="text-muted small"><i class="bi bi-truck me-1"></i>@item.User.Immatriculation</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>@item.User.DateCreation.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.User.EstActif)
                                    {
                                        <span class="bt-badge bt-badge-accent"><i class="bi bi-check-circle"></i> Actif</span>
                                    }
                                    else
                                    {
                                        <span class="bt-badge bt-badge-danger"><i class="bi bi-x-circle"></i> Inactif</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="ToggleUser" asp-route-id="@item.User.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="bt-btn bt-btn-outline bt-btn-sm" title="@(item.User.EstActif ? "Désactiver" : "Activer")">
                                            @if (item.User.EstActif)
                                            {
                                                <i class="bi bi-slash-circle text-warning"></i> <span>Désactiver</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-check2 text-success"></i> <span>Réactiver</span>
                                            }
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Aucun utilisateur trouvé.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
