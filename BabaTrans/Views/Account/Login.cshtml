@model BabaTrans.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Connexion";
}

<div class="bt-login-page">
    <div class="bt-login-card fade-in">
        <div class="login-logo">
            <i class="bi bi-truck"></i>
        </div>
        <h2>BABA-TRANS</h2>
        <div class="login-subtitle">Système intégré de suivi et de livraison de colis</div>

        <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="bt-alert bt-alert-danger mb-3" role="alert"></div>

            <div class="bt-form-group">
                <label asp-for="Email" class="bt-form-label"><i class="bi bi-envelope me-1"></i> Adresse email</label>
                <input asp-for="Email" class="bt-form-control" placeholder="exemple@babatrans.cd" autocomplete="username" id="emailInput" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="bt-form-group">
                <label asp-for="Password" class="bt-form-label"><i class="bi bi-shield-lock me-1"></i> Mot de passe</label>
                <input asp-for="Password" class="bt-form-control" placeholder="••••••••" autocomplete="current-password" id="passwordInput" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label text-muted small">Rester connecté</label>
            </div>

            <button type="submit" class="bt-btn bt-btn-primary w-100 justify-content-center mb-3">
                <i class="bi bi-box-arrow-in-right"></i> Se connecter
            </button>
        </form>

        <div class="text-center pt-3 border-top small text-muted">
            Vous avez un code de suivi ?
            <a asp-controller="Colis" asp-action="Suivi" class="fw-semibold text-decoration-none">Suivre un colis sans compte</a>
        </div>

        <!-- Comptes de démonstration prédéfinis -->
        <div class="bt-demo-accounts">
            <div class="text-uppercase small fw-bold text-muted mb-2 text-center" style="letter-spacing: 1px;">
                <i class="bi bi-lightning-charge-fill text-warning"></i> Comptes de démonstration
            </div>
            <div class="d-grid gap-2">
                <button type="button" class="bt-btn bt-btn-outline bt-btn-sm" data-email="admin@babatrans.cd" data-password="Admin@123">
                    <span class="bt-badge bt-badge-danger">Admin</span> admin@babatrans.cd
                </button>
                <button type="button" class="bt-btn bt-btn-outline bt-btn-sm" data-email="agent@babatrans.cd" data-password="Agent@123">
                    <span class="bt-badge bt-badge-info">Agent</span> agent@babatrans.cd
                </button>
                <button type="button" class="bt-btn bt-btn-outline bt-btn-sm" data-email="livreur@babatrans.cd" data-password="Livreur@123">
                    <span class="bt-badge bt-badge-accent">Livreur</span> livreur@babatrans.cd
                </button>
                <button type="button" class="bt-btn bt-btn-outline bt-btn-sm" data-email="client@kinmarche.cd" data-password="Client@123">
                    <span class="bt-badge bt-badge-warning">Client</span> client@kinmarche.cd
                </button>
            </div>
            <div class="text-center text-muted mt-2" style="font-size: 0.72rem;">Un clic remplit le formulaire.</div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.bt-demo-accounts [data-email]').forEach((bouton) => {
            bouton.addEventListener('click', () => {
                document.getElementById('emailInput').value = bouton.dataset.email;
                document.getElementById('passwordInput').value = bouton.dataset.password;
                document.getElementById('passwordInput').focus();
            });
        });
    </script>
}
