@model BabaTrans.Models.Colis
@{
    ViewData["Title"] = "Colis #" + Model.Id + " - " + Model.CodeSuivi;
    var peutAffecter = ViewBag.PeutAffecter == true;
    var aUnTimbre = Model.TimbreQRCode != null && !string.IsNullOrEmpty(Model.TimbreQRCode.ImageBase64);
}

<div class="bt-page-header no-print">
    <div>
        <h4 class="fw-bold text-heading">
            <i class="bi bi-box2-fill text-primary me-2"></i>Colis #@Model.Id
            <span class="bt-badge @Model.Statut.Badge() ms-2 align-middle">@Model.Statut.Libelle()</span>
        </h4>
        <div class="text-muted small">Code de suivi : <span class="bt-code">@Model.CodeSuivi</span></div>
    </div>
    <div class="bt-page-actions">
        @if (aUnTimbre)
        {
            <button type="button" onclick="window.print()" class="bt-btn bt-btn-outline bt-btn-sm">
                <i class="bi bi-printer"></i> Imprimer le timbre
            </button>
        }
        <a asp-action="Suivi" asp-route-code="@Model.CodeSuivi" class="bt-btn bt-btn-outline bt-btn-sm">
            <i class="bi bi-upc-scan"></i> Page de suivi
        </a>
        <a asp-action="Index" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-arrow-left"></i> Liste</a>
    </div>
</div>

<div class="row g-4">
    <!-- Timbre QR-code : seule partie imprimée -->
    <div class="col-lg-5 print-full">
        <div class="bt-card" id="printableStamp">
            <div class="bt-card-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-patch-check-fill text-primary fs-5"></i>
                    <h5 class="mb-0">Timbre officiel BABA-TRANS</h5>
                </div>
                <span class="bt-badge bt-badge-primary text-uppercase">RDC Logistics</span>
            </div>
            <div class="bt-card-body text-center p-4">
                @if (aUnTimbre)
                {
                    <div class="bt-qr-code mb-3">
                        <img src="data:image/png;base64,@Model.TimbreQRCode!.ImageBase64" alt="QR-code du colis @Model.CodeSuivi" />
                    </div>
                    <div class="font-monospace fw-bold text-heading fs-5 mb-1">@Model.CodeSuivi</div>
                    <div class="text-muted small mb-3">Généré le @Model.TimbreQRCode.DateGeneration.ToString("dd/MM/yyyy HH:mm")</div>

                    <div class="bt-panel text-start small">
                        <div class="row g-1">
                            <div class="col-5 text-muted">Supermarché</div>
                            <div class="col-7 text-end fw-semibold text-heading">@(Model.Commande?.Client?.NomSupermarche ?? "N/A")</div>
                            <div class="col-5 text-muted">Destination</div>
                            <div class="col-7 text-end fw-semibold text-heading">@(Model.Commande?.VilleDestination ?? "N/A")</div>
                            @if (!string.IsNullOrEmpty(Model.Commande?.ContactDestination))
                            {
                                <div class="col-5 text-muted">Destinataire</div>
                                <div class="col-7 text-end fw-semibold text-heading">@Model.Commande.ContactDestination</div>
                            }
                            <div class="col-5 text-muted">Poids</div>
                            <div class="col-7 text-end fw-bold text-primary-bt">@Model.Poids kg</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="py-5 text-muted">
                        <i class="bi bi-qr-code fs-1 d-block mb-2"></i>
                        Aucun timbre généré pour ce colis.
                        <form asp-action="GenererQRCode" asp-route-id="@Model.Id" method="post" class="mt-3">
                            <button type="submit" class="bt-btn bt-btn-primary bt-btn-sm">
                                <i class="bi bi-arrow-repeat"></i> Générer le timbre QR
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Informations détaillées & livraisons -->
    <div class="col-lg-7 no-print">
        <div class="bt-card mb-4">
            <div class="bt-card-header">
                <h5>Détails logistiques</h5>
            </div>
            <div class="bt-card-body">
                <dl class="row bt-dl">
                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@Model.Description</dd>

                    <dt class="col-sm-4">Poids</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Poids kg</dd>

                    <dt class="col-sm-4">Commande</dt>
                    <dd class="col-sm-8">
                        <a asp-controller="Commande" asp-action="Details" asp-route-id="@Model.CommandeId" class="text-decoration-none fw-semibold">
                            CMD-@Model.CommandeId
                        </a>
                        <span class="text-muted">· @(Model.Commande?.Client?.NomSupermarche ?? "Inconnu")</span>
                        @if (Model.Commande != null)
                        {
                            <span class="bt-badge @Model.Commande.Statut.Badge() ms-1">@Model.Commande.Statut.Libelle()</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Enregistré le</dt>
                    <dd class="col-sm-8">@Model.DateEnregistrement.ToString("dd MMMM yyyy 'à' HH:mm")</dd>
                </dl>
            </div>
        </div>

        <div class="bt-card">
            <div class="bt-card-header">
                <h5><i class="bi bi-send text-primary me-2"></i>Livraisons & scans</h5>
                @if (peutAffecter)
                {
                    <a asp-controller="Livraison" asp-action="Create" asp-route-colisId="@Model.Id" class="bt-btn bt-btn-primary bt-btn-sm">
                        <i class="bi bi-plus-lg"></i> Affecter à un livreur
                    </a>
                }
            </div>
            <div class="bt-card-body p-0">
                <div class="table-responsive">
                    <table class="bt-table">
                        <thead>
                            <tr>
                                <th>Réf</th>
                                <th>Livreur & véhicule</th>
                                <th>Scans</th>
                                <th>Statut</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Livraisons.Any())
                            {
                                foreach (var liv in Model.Livraisons.OrderByDescending(l => l.Id))
                                {
                                    <tr>
                                        <td class="fw-bold text-heading">#@liv.Id</td>
                                        <td>
                                            <div class="fw-semibold text-nowrap">@(liv.Livreur != null ? $"{liv.Livreur.Prenom} {liv.Livreur.Nom}" : "Non assigné")</div>
                                            <div class="text-muted small">@(liv.MoyenTransport?.Type ?? "Sans véhicule")</div>
                                        </td>
                                        <td class="small text-nowrap">
                                            <div><span class="text-muted">Départ</span> @(liv.DateDepart?.ToString("dd/MM HH:mm") ?? "—")</div>
                                            <div><span class="text-muted">Arrivée</span> @(liv.DateArrivee?.ToString("dd/MM HH:mm") ?? "—")</div>
                                        </td>
                                        <td><span class="bt-badge @liv.Statut.Badge()">@liv.Statut.Libelle()</span></td>
                                        <td class="text-end">
                                            <a asp-controller="Livraison" asp-action="Details" asp-route-id="@liv.Id" class="bt-btn bt-btn-outline bt-btn-sm" title="Ouvrir la livraison">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        Ce colis n'a pas encore été affecté à une livraison.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
