@model IEnumerable<BabaTrans.Models.Colis>
@{
    ViewData["Title"] = "Gestion des Colis & Timbres QR";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-1"><i class="bi bi-qr-code-scan text-primary me-2"></i>Colis & Timbres QR-Code</h4>
        <div class="text-muted small">Traçabilité numérique des marchandises et génération des timbres sécurisés</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Suivi" class="bt-btn bt-btn-outline">
            <i class="bi bi-search"></i> Module de Suivi
        </a>
        <a asp-action="Create" class="bt-btn bt-btn-primary">
            <i class="bi bi-plus-lg"></i> Enregistrer un Colis
        </a>
    </div>
</div>

<div class="bt-card fade-in">
    <div class="bt-card-body p-0">
        <div class="table-responsive">
            <table class="bt-table">
                <thead>
                    <tr>
                        <th>N° Colis</th>
                        <th>Code de Suivi</th>
                        <th>Commande & Supermarché</th>
                        <th>Description</th>
                        <th>Poids</th>
                        <th>Timbre QR-Code</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var colis in Model)
                        {
                            var badgeClass = colis.Statut switch {
                                BabaTrans.Models.StatutColis.Enregistre => "bt-badge-warning",
                                BabaTrans.Models.StatutColis.QRCodeGenere => "bt-badge-info",
                                BabaTrans.Models.StatutColis.EnTransit => "bt-badge-orange",
                                BabaTrans.Models.StatutColis.Arrive => "bt-badge-primary",
                                BabaTrans.Models.StatutColis.Livre => "bt-badge-accent",
                                BabaTrans.Models.StatutColis.Retourne => "bt-badge-danger",
                                _ => "bt-badge-primary"
                            };

                            <tr>
                                <td class="fw-bold text-white">#@colis.Id</td>
                                <td>
                                    <span class="badge bg-dark border border-secondary font-monospace text-light">@colis.CodeSuivi</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-white">CMD-@colis.CommandeId</div>
                                    <div class="text-muted small">@colis.Commande?.Client?.NomSupermarche</div>
                                </td>
                                <td>@colis.Description</td>
                                <td><span class="badge bg-secondary">@colis.Poids kg</span></td>
                                <td>
                                    @if (colis.TimbreQRCode != null && !string.IsNullOrEmpty(colis.TimbreQRCode.ImageBase64))
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="data:image/png;base64,@colis.TimbreQRCode.ImageBase64" alt="QR" style="width: 32px; height: 32px; border-radius: 4px; background: white; padding: 2px;" />
                                            <span class="bt-badge bt-badge-accent">Généré</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="bt-badge bt-badge-warning">En attente</span>
                                    }
                                </td>
                                <td>
                                    <span class="bt-badge @badgeClass">@colis.Statut</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@colis.Id" class="bt-btn bt-btn-outline bt-btn-sm" title="Voir timbre et détails">
                                            <i class="bi bi-eye"></i> Fiche & QR
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="bt-empty-state">
                                    <i class="bi bi-qr-code"></i>
                                    <h5>Aucun colis enregistré</h5>
                                    <p>Enregistrez un nouveau colis pour générer automatiquement son timbre QR-Code.</p>
                                    <a asp-action="Create" class="bt-btn bt-btn-primary bt-btn-sm">
                                        <i class="bi bi-plus-lg"></i> Enregistrer un colis
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
