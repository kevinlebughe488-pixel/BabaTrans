@model IEnumerable<BabaTrans.Models.Colis>
@{
    ViewData["Title"] = "Gestion des Colis & Timbres QR";
    var colisAvecTimbre = ViewBag.ColisAvecTimbre as HashSet<int> ?? new HashSet<int>();
}

<div class="bt-page-header">
    <div>
        <h4 class="fw-bold text-heading"><i class="bi bi-qr-code-scan text-primary me-2"></i>Colis & timbres QR-code</h4>
        <div class="text-muted small">Traçabilité numérique des marchandises et timbres sécurisés</div>
    </div>
    <div class="bt-page-actions">
        <a asp-action="Suivi" class="bt-btn bt-btn-outline">
            <i class="bi bi-search"></i> Suivre un colis
        </a>
        <a asp-action="Create" class="bt-btn bt-btn-primary">
            <i class="bi bi-plus-lg"></i> Enregistrer un colis
        </a>
    </div>
</div>

<div class="bt-card fade-in">
    <div class="bt-card-body p-0">
        <div class="table-responsive">
            <table class="bt-table">
                <thead>
                    <tr>
                        <th>N° Colis</th>
                        <th>Code de suivi</th>
                        <th>Commande</th>
                        <th>Description</th>
                        <th>Poids</th>
                        <th>Timbre QR</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var colis in Model)
                        {
                            <tr>
                                <td class="fw-bold text-heading">#@colis.Id</td>
                                <td><span class="bt-code">@colis.CodeSuivi</span></td>
                                <td>
                                    <a asp-controller="Commande" asp-action="Details" asp-route-id="@colis.CommandeId" class="fw-semibold text-decoration-none">CMD-@colis.CommandeId</a>
                                    <div class="text-muted small">@colis.Commande?.Client?.NomSupermarche → @colis.Commande?.VilleDestination</div>
                                </td>
                                <td>@colis.Description</td>
                                <td class="text-nowrap">@colis.Poids kg</td>
                                <td>
                                    @if (colisAvecTimbre.Contains(colis.Id))
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@Url.Action("QRImage", new { id = colis.Id })" alt="QR du colis #@colis.Id" width="32" height="32" loading="lazy" class="rounded border" />
                                            <span class="bt-badge bt-badge-accent">Généré</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="bt-badge bt-badge-warning">En attente</span>
                                    }
                                </td>
                                <td>
                                    <span class="bt-badge @colis.Statut.Badge()">@colis.Statut.Libelle()</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@colis.Id" class="bt-btn bt-btn-outline bt-btn-sm" title="Voir le timbre et les détails">
                                        <i class="bi bi-eye"></i> Fiche & QR
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="bt-empty-state">
                                    <i class="bi bi-qr-code"></i>
                                    <h5>Aucun colis enregistré</h5>
                                    <p>Enregistrez un colis pour générer automatiquement son timbre QR-code.</p>
                                    <a asp-action="Create" class="bt-btn bt-btn-primary bt-btn-sm">
                                        <i class="bi bi-plus-lg"></i> Enregistrer un colis
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
