@model BabaTrans.ViewModels.SuiviColisViewModel
@using BabaTrans.Models
@{
    ViewData["Title"] = "Suivi de Colis";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <!-- Recherche -->
        <div class="bt-card mb-4 text-center p-4 fade-in">
            <div class="mb-3">
                <i class="bi bi-upc-scan text-primary" style="font-size: 3rem;"></i>
            </div>
            <h3 class="fw-bold text-heading mb-2">Suivi numérique de colis</h3>
            <p class="text-muted mb-4">Saisissez le code de suivi inscrit sous le timbre QR pour suivre votre cargaison à travers la RDC.</p>

            <form asp-action="Suivi" method="get" class="row justify-content-center g-2">
                <div class="col-md-7">
                    <input type="text" name="code" value="@Model.CodeSuivi" class="bt-form-control text-center font-monospace fs-5 py-2 text-uppercase"
                           placeholder="Ex : BT-20260926-XXXXXXXX" required maxlength="50" autocomplete="off" aria-label="Code de suivi" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="bt-btn bt-btn-primary w-100 py-2 justify-content-center">
                        <i class="bi bi-search"></i> Rechercher
                    </button>
                </div>
            </form>
        </div>

        @if (Model.Recherche)
        {
            if (Model.Colis != null)
            {
                var colis = Model.Colis;
                var derniere = Model.Livraisons.FirstOrDefault();
                var retourne = colis.Statut == StatutColis.Retourne;
                var rang = colis.Statut switch
                {
                    StatutColis.Enregistre => 1,
                    StatutColis.QRCodeGenere => 2,
                    StatutColis.EnTransit => 3,
                    StatutColis.Arrive => 4,
                    StatutColis.Livre => 5,
                    _ => 0
                };
                // L'étape actuelle est mise en évidence (et non la suivante) : un colis en transit n'apparaît pas comme arrivé.
                string Etat(int etape) => retourne ? "" : rang > etape || (rang == etape && etape == 5) ? "completed" : rang == etape ? "active" : "";

                <div class="bt-card fade-in mb-4">
                    <div class="bt-card-header">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-box-seam-fill text-primary fs-4"></i>
                            <div>
                                <h5 class="mb-0">Colis <span class="bt-code">@colis.CodeSuivi</span></h5>
                                <small class="text-muted">Enregistré le @colis.DateEnregistrement.ToString("dd/MM/yyyy 'à' HH:mm")</small>
                            </div>
                        </div>
                        <span class="bt-badge @colis.Statut.Badge()">@colis.Statut.Libelle()</span>
                    </div>

                    <div class="bt-card-body">
                        @if (retourne)
                        {
                            <div class="bt-alert bt-alert-danger">
                                <i class="bi bi-arrow-return-left fs-5"></i>
                                <div>Ce colis a été retourné à l'expéditeur. Contactez BABA-Trans pour plus d'informations.</div>
                            </div>
                        }
                        else if (derniere?.Statut == StatutLivraison.Echouee && colis.Statut.EstAffectable())
                        {
                            <div class="bt-alert bt-alert-warning">
                                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                <div>La dernière tentative de livraison a échoué. Le colis est de retour au dépôt et va être réexpédié.</div>
                            </div>
                        }

                        <!-- Avancement -->
                        <div class="bt-progress-tracker my-3">
                            <div class="bt-progress-step @Etat(1)">
                                <div class="step-icon"><i class="bi bi-clipboard-check"></i></div>
                                <div class="step-label">Enregistré</div>
                                <div class="step-date">@colis.DateEnregistrement.ToString("dd/MM HH:mm")</div>
                            </div>
                            <div class="bt-progress-step @Etat(2)">
                                <div class="step-icon"><i class="bi bi-qr-code"></i></div>
                                <div class="step-label">Timbre QR émis</div>
                            </div>
                            <div class="bt-progress-step @Etat(3)">
                                <div class="step-icon"><i class="bi bi-truck"></i></div>
                                <div class="step-label">En transit</div>
                                @if (rang >= 3 && derniere?.DateDepart != null)
                                {
                                    <div class="step-date">@derniere.DateDepart.Value.ToString("dd/MM HH:mm")</div>
                                }
                            </div>
                            <div class="bt-progress-step @Etat(4)">
                                <div class="step-icon"><i class="bi bi-geo-alt"></i></div>
                                <div class="step-label">Arrivé à destination</div>
                                @if (rang >= 4 && derniere?.DateArrivee != null)
                                {
                                    <div class="step-date">@derniere.DateArrivee.Value.ToString("dd/MM HH:mm")</div>
                                }
                            </div>
                            <div class="bt-progress-step @Etat(5)">
                                <div class="step-icon"><i class="bi bi-check-all"></i></div>
                                <div class="step-label">Livré</div>
                                @if (rang >= 5 && derniere?.DateLivraison != null)
                                {
                                    <div class="step-date">@derniere.DateLivraison.Value.ToString("dd/MM HH:mm")</div>
                                }
                            </div>
                        </div>

                        <div class="row g-4 mt-1">
                            <div class="@(Model.AccesComplet ? "col-md-7" : "col-12")">
                                <h6 class="text-uppercase text-muted small fw-bold mb-3">Informations d'expédition</h6>
                                <div class="bt-panel">
                                    <dl class="row bt-dl">
                                        <dt class="col-sm-5">Destination</dt>
                                        <dd class="col-sm-7 fw-bold"><i class="bi bi-geo-alt text-danger me-1"></i>@(colis.Commande?.VilleDestination ?? "N/A")</dd>

                                        @if (Model.AccesComplet)
                                        {
                                            <dt class="col-sm-5">Supermarché</dt>
                                            <dd class="col-sm-7">@(colis.Commande?.Client?.NomSupermarche ?? "N/A")</dd>

                                            <dt class="col-sm-5">Contenu</dt>
                                            <dd class="col-sm-7">@colis.Description</dd>

                                            <dt class="col-sm-5">Poids</dt>
                                            <dd class="col-sm-7">@colis.Poids kg</dd>

                                            if (derniere?.MoyenTransport != null)
                                            {
                                                <dt class="col-sm-5">Véhicule</dt>
                                                <dd class="col-sm-7">
                                                    @derniere.MoyenTransport.Type
                                                    @if (!string.IsNullOrEmpty(derniere.MoyenTransport.Immatriculation))
                                                    {
                                                        <span class="bt-code ms-1">@derniere.MoyenTransport.Immatriculation</span>
                                                    }
                                                </dd>
                                            }
                                            if (derniere?.Livreur != null)
                                            {
                                                <dt class="col-sm-5">Livreur</dt>
                                                <dd class="col-sm-7">@derniere.Livreur.Prenom @derniere.Livreur.Nom</dd>
                                            }
                                        }
                                    </dl>
                                </div>
                                @if (!Model.AccesComplet)
                                {
                                    <div class="text-muted small mt-2">
                                        <i class="bi bi-lock me-1"></i>Le détail du contenu et du livreur est réservé au supermarché expéditeur et au personnel BABA-Trans.
                                    </div>
                                }
                            </div>

                            @if (Model.AccesComplet)
                            {
                                <div class="col-md-5 text-center">
                                    <h6 class="text-uppercase text-muted small fw-bold mb-3">Timbre numérique</h6>
                                    @if (!string.IsNullOrEmpty(colis.TimbreQRCode?.ImageBase64))
                                    {
                                        <div class="bt-qr-code">
                                            <img src="data:image/png;base64,@colis.TimbreQRCode.ImageBase64" alt="QR-code du colis" style="width: 150px; height: 150px;" />
                                        </div>
                                        <div class="mt-2 text-muted small"><i class="bi bi-shield-check text-success me-1"></i>Signature du timbre vérifiée</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted py-4">Aucun timbre valide disponible.</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                // Carte en direct : réservée au personnel, au livreur et au supermarché propriétaire.
                if (Model.AccesComplet && derniere != null && derniere.Statut != StatutLivraison.Echouee)
                {
                    <partial name="_SuiviGps" model="derniere" />
                }
            }
            else
            {
                <div class="bt-card fade-in">
                    <div class="bt-empty-state">
                        <i class="bi bi-question-circle text-warning"></i>
                        <h5>Aucun colis trouvé pour le code « @Model.CodeSuivi »</h5>
                        <p>Vérifiez le code : il a la forme BT-AAAAMMJJ-XXXXXXXX et figure sous le QR-code du timbre.</p>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <partial name="_CarteScripts" />
}
