@model BabaTrans.Models.Colis
@{
    ViewData["Title"] = "Enregistrer un Colis";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="bt-card fade-in">
            <div class="bt-card-header">
                <h5><i class="bi bi-box-arrow-in-down text-primary me-2"></i>Enregistrer un colis</h5>
                <a asp-action="Index" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-arrow-left"></i> Retour</a>
            </div>
            <div class="bt-card-body">
                <div class="bt-alert bt-alert-info mb-4">
                    <i class="bi bi-qr-code fs-3"></i>
                    <div>
                        <strong>Timbre QR-code automatique</strong>
                        <div class="small">À la validation, un timbre QR-code signé est généré, prêt à être imprimé et collé sur le paquet.</div>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="bt-alert bt-alert-danger mb-4"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="CommandeId" class="bt-form-label">Commande associée</label>
                            <select asp-for="CommandeId" class="bt-form-control" asp-items="ViewBag.Commandes">
                                <option value="">-- Sélectionnez la commande concernée --</option>
                            </select>
                            <span asp-validation-for="CommandeId" class="text-danger small"></span>
                            <div class="bt-form-hint">Seules les commandes en attente ou en cours sont proposées.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Poids" class="bt-form-label"></label>
                            <div class="input-group">
                                <input asp-for="Poids" class="bt-form-control" type="number" min="0.1" max="10000" step="0.1" placeholder="Ex : 25.5" />
                                <span class="input-group-text">kg</span>
                            </div>
                            <span asp-validation-for="Poids" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Description" class="bt-form-label">Contenu / description des marchandises</label>
                            <textarea asp-for="Description" class="bt-form-control" rows="3" placeholder="Ex : cartons d'huile végétale, conserves alimentaires, produits laitiers..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="bt-btn bt-btn-outline">Annuler</a>
                        <button type="submit" class="bt-btn bt-btn-primary">
                            <i class="bi bi-qr-code"></i> Enregistrer & générer le timbre
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
