@{
    // Nom, initiales et rôle viennent du cookie de connexion : aucune requête en base à chaque page.
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string Actif(bool condition) => condition ? "active" : "";
}

<aside class="bt-sidebar" id="sidebarMenu">
    <div class="bt-sidebar-brand">
        <div class="brand-icon">
            <i class="bi bi-truck"></i>
        </div>
        <div>
            <h5>BABA-TRANS</h5>
            <small>Système Logistique RDC</small>
        </div>
    </div>

    <nav class="bt-sidebar-nav">
        <div class="nav-section">
            <div class="nav-section-title">Navigation</div>
            <a class="nav-link @Actif(currentController == "Dashboard")" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Tableau de bord</span>
            </a>
            <a class="nav-link @Actif(currentController == "Colis" && currentAction == "Suivi")" asp-controller="Colis" asp-action="Suivi">
                <i class="bi bi-search"></i>
                <span>Suivre un colis</span>
            </a>
        </div>

        @if (User.EstPersonnel())
        {
            <div class="nav-section">
                <div class="nav-section-title">Opérations Logistiques</div>
                <a class="nav-link @Actif(currentController == "Client")" asp-controller="Client" asp-action="Index">
                    <i class="bi bi-shop"></i>
                    <span>Supermarchés (Clients)</span>
                </a>
                <a class="nav-link @Actif(currentController == "Commande")" asp-controller="Commande" asp-action="Index">
                    <i class="bi bi-box-seam"></i>
                    <span>Commandes</span>
                </a>
                <a class="nav-link @Actif(currentController == "Colis" && currentAction != "Suivi")" asp-controller="Colis" asp-action="Index">
                    <i class="bi bi-qr-code"></i>
                    <span>Colis & Timbres QR</span>
                </a>
                <a class="nav-link @Actif(currentController == "Livraison")" asp-controller="Livraison" asp-action="Index">
                    <i class="bi bi-send-check"></i>
                    <span>Livraisons & Affectations</span>
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-section-title">Réseau & Flotte</div>
                <a class="nav-link @Actif(currentController == "Transport" && currentAction.Contains("Trajet"))" asp-controller="Transport" asp-action="Trajets">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span>Trajets inter-villes</span>
                </a>
                <a class="nav-link @Actif(currentController == "Transport" && currentAction.Contains("Moyen"))" asp-controller="Transport" asp-action="Moyens">
                    <i class="bi bi-truck-front-fill"></i>
                    <span>Moyens de Transport</span>
                </a>
            </div>
        }
        else if (User.IsInRole("Livreur"))
        {
            <div class="nav-section">
                <div class="nav-section-title">Espace Livreur</div>
                <a class="nav-link @Actif(currentController == "Livraison")" asp-controller="Livraison" asp-action="Index">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Mes Livraisons & Scans</span>
                </a>
            </div>
        }
        else if (User.IsInRole("Client"))
        {
            <div class="nav-section">
                <div class="nav-section-title">Espace Supermarché</div>
                <a class="nav-link @Actif(currentController == "Commande" && currentAction != "Create")" asp-controller="Commande" asp-action="Index">
                    <i class="bi bi-bag-check-fill"></i>
                    <span>Mes Commandes</span>
                </a>
                <a class="nav-link @Actif(currentController == "Commande" && currentAction == "Create")" asp-controller="Commande" asp-action="Create">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Passer une commande</span>
                </a>
            </div>
        }

        @if (User.IsInRole("Administrateur"))
        {
            <div class="nav-section">
                <div class="nav-section-title">Administration SI</div>
                <a class="nav-link @Actif(currentController == "Account" && (currentAction == "Users" || currentAction == "Register"))" asp-controller="Account" asp-action="Users">
                    <i class="bi bi-people-fill"></i>
                    <span>Gestion Utilisateurs & RBAC</span>
                </a>
                <a class="nav-link @Actif(currentController == "Rapport")" asp-controller="Rapport" asp-action="Index">
                    <i class="bi bi-bar-chart-line-fill"></i>
                    <span>Rapports d'activité</span>
                </a>
            </div>
        }
    </nav>

    <div class="bt-sidebar-footer">
        <div class="user-info">
            <div class="user-avatar">@User.Initiales()</div>
            <div class="overflow-hidden">
                <div class="user-name text-truncate">@User.NomComplet()</div>
                <span class="bt-role-badge">@User.RolePrincipal()</span>
            </div>
        </div>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="bt-btn bt-btn-outline bt-btn-sm bt-sidebar-logout">
                <i class="bi bi-box-arrow-right"></i> Déconnexion
            </button>
        </form>
    </div>
</aside>
