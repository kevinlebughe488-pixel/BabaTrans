@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="bt-card p-5">
            <div class="mb-4">
                <i class="bi bi-exclamation-octagon text-danger" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-heading mb-2">Une erreur est survenue</h2>
            <p class="text-muted mb-4">
                La demande n'a pas pu aboutir. Réessayez dans quelques instants ; si le problème persiste, contactez l'équipe BABA-Trans.
            </p>
            @if (Model.ShowRequestId)
            {
                <p class="small text-muted">Référence de l'incident : <span class="bt-code">@Model.RequestId</span></p>
            }
            <a asp-controller="Home" asp-action="Index" class="bt-btn bt-btn-primary">
                <i class="bi bi-house-door"></i> Retour à l'accueil
            </a>
        </div>
    </div>
</div>
