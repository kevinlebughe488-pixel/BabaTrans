@model BabaTrans.Models.Commande
@{
    ViewData["Title"] = "Déposer une Commande";
    var estClient = ViewBag.EstClient == true;
}

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-10">
        <div class="bt-card fade-in">
            <div class="bt-card-header">
                <h5><i class="bi bi-box-seam text-primary me-2"></i>Nouvelle commande de livraison</h5>
                <a asp-action="Index" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-arrow-left"></i> Retour</a>
            </div>
            <div class="bt-card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="bt-alert bt-alert-danger mb-4"></div>

                    <div class="row g-3">
                        @if (estClient)
                        {
                            var clientConnecte = ViewBag.ClientConnecte as BabaTrans.Models.Client;
                            <div class="col-md-6">
                                <label class="bt-form-label" for="supermarcheConnecte">Votre supermarché</label>
                                <input id="supermarcheConnecte" class="bt-form-control" value="@(clientConnecte?.NomSupermarche ?? "Compte supermarché")" readonly />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6">
                                <label asp-for="ClientId" class="bt-form-label">Supermarché client</label>
                                <select asp-for="ClientId" class="bt-form-control" asp-items="ViewBag.Clients">
                                    <option value="">-- Sélectionnez le supermarché expéditeur --</option>
                                </select>
                                <span asp-validation-for="ClientId" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-md-6">
                            <label asp-for="PoidsEstimeKg" class="bt-form-label"></label>
                            <div class="input-group">
                                <input asp-for="PoidsEstimeKg" class="bt-form-control" type="number" min="0.1" max="10000" step="0.01" placeholder="Ex : 125" />
                                <span class="input-group-text">kg</span>
                            </div>
                            <span asp-validation-for="PoidsEstimeKg" class="text-danger small"></span>
                            <div class="bt-form-hint">Estimation du poids total. Le tarif sera recalculé sur le poids réel des colis.</div>
                        </div>

                        <partial name="_CarteDestination" model="Model" />
                        <partial name="_ChampsDestination" model="Model" />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="bt-btn bt-btn-outline">Annuler</a>
                        <button type="submit" class="bt-btn bt-btn-primary">
                            <i class="bi bi-check-circle"></i> Valider la commande
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_CarteScripts" />
}
