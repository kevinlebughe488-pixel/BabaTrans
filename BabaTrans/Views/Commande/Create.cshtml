@model BabaTrans.Models.Commande
@using System.Text.Json
@{
    ViewData["Title"] = "Déposer une Commande";
    var tarifs = ViewBag.ParametresTarification as BabaTrans.Services.ParametresTarification;
    var tarifsJson = JsonSerializer.Serialize(tarifs ?? new BabaTrans.Services.ParametresTarification(2000m, 150m, 3000m, 5000m, new Dictionary<string, decimal>()));
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="bt-card fade-in">
            <div class="bt-card-header">
                <h5><i class="bi bi-box-seam text-primary me-2"></i>Nouvelle Commande de Livraison</h5>
                <a asp-action="Index" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-arrow-left"></i> Retour</a>
            </div>
            <div class="bt-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="bt-alert bt-alert-danger mb-4"></div>

                    <div class="row g-3">
                        @if (ViewBag.EstClient == true)
                        {
                            var clientConnecte = ViewBag.ClientConnecte as BabaTrans.Models.Client;
                            <div class="col-md-12">
                                <label class="bt-form-label">Votre supermarché</label>
                                <input class="bt-form-control" value="@(clientConnecte?.NomSupermarche ?? "Compte supermarché")" readonly />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-12">
                                <label asp-for="ClientId" class="bt-form-label">Supermarché Client</label>
                                <select asp-for="ClientId" class="bt-form-control" asp-items="ViewBag.Clients">
                                    <option value="">-- Sélectionnez le supermarché expéditeur --</option>
                                </select>
                                <span asp-validation-for="ClientId" class="text-danger"></span>
                            </div>
                        }

                        <div class="col-md-6">
                            <label asp-for="VilleDestination" class="bt-form-label"></label>
                            <input asp-for="VilleDestination" class="bt-form-control" id="destinationInput" placeholder="Ex: Lubumbashi, Goma, Matadi, Kisangani" />
                            <span asp-validation-for="VilleDestination" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PoidsEstimeKg" class="bt-form-label"></label>
                            <div class="input-group">
                                <input asp-for="PoidsEstimeKg" class="bt-form-control" id="poidsEstimeInput" type="number" min="0.1" max="10000" step="0.1" placeholder="Ex: 125" />
                                <span class="input-group-text">kg</span>
                            </div>
                            <span asp-validation-for="PoidsEstimeKg" class="text-danger"></span>
                            <div class="text-muted small mt-1">Estimation du poids total de l'expédition.</div>
                        </div>

                        @if (ViewBag.EstClient != true)
                        {
                            <div class="col-md-6">
                                <label asp-for="TrajetId" class="bt-form-label">Trajet Prévu (Optionnel)</label>
                                <select asp-for="TrajetId" class="bt-form-control" asp-items="ViewBag.Trajets">
                                    <option value="">-- Affectation automatique ultérieure --</option>
                                </select>
                                <span asp-validation-for="TrajetId" class="text-danger"></span>
                            </div>
                        }

                        <div class="col-md-6">
                            <label asp-for="ContactDestination" class="bt-form-label">Contact destinataire</label>
                            <input asp-for="ContactDestination" class="bt-form-control" placeholder="Nom du destinataire ou contact" />
                            <span asp-validation-for="ContactDestination" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TelephoneDestination" class="bt-form-label">Téléphone destinataire</label>
                            <input asp-for="TelephoneDestination" class="bt-form-control" placeholder="Ex: +243 81 000 0000" />
                            <span asp-validation-for="TelephoneDestination" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Description" class="bt-form-label">Détails / Instructions Spéciales</label>
                            <textarea asp-for="Description" class="bt-form-control" rows="3" placeholder="Nature des marchandises, précautions particulières, denrées périssables, point d'accès, etc."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <div class="p-3 rounded-3 border bg-light" style="border-color: #cbd5e1 !important;">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                    <div>
                                        <div class="fw-semibold text-dark d-flex align-items-center gap-2">
                                            <i class="bi bi-calculator-fill text-primary"></i> Montant estimé de la livraison
                                        </div>
                                        <div class="text-muted small mt-1">
                                            Calculé selon la destination et le poids. Le montant définitif pourra être ajusté après pesée réelle.
                                        </div>
                                    </div>
                                    <div class="text-md-end">
                                        <div id="tarifEstime"></div>
                                        <div class="text-muted small" id="detailTarif"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top border-secondary-subtle">
                        <a asp-action="Index" class="bt-btn bt-btn-outline">Annuler</a>
                        <button type="submit" class="bt-btn bt-btn-primary">
                            <i class="bi bi-check-circle"></i> Valider la Commande
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const tarifConfig = @Html.Raw(tarifsJson);

        const destinationInput = document.getElementById('destinationInput');
        const poidsInput = document.getElementById('poidsEstimeInput');
        const tarifEstime = document.getElementById('tarifEstime');
        const detailTarif = document.getElementById('detailTarif');

        function calculerTarif() {
            const poids = Number.parseFloat(poidsInput.value);
            if (!Number.isFinite(poids) || poids <= 0) {
                tarifEstime.innerHTML = '';
                detailTarif.textContent = '';
                return;
            }

            const destination = (destinationInput?.value || '').trim().toUpperCase();
            const supplement = Object.entries(tarifConfig.SupplementsDestination)
                .find(([ville]) => ville.trim().toUpperCase() === destination)?.[1]
                ?? tarifConfig.SupplementDestinationParDefaut;
            const montant = Math.max(
                tarifConfig.MinimumFacturable,
                tarifConfig.ForfaitBase + (poids * tarifConfig.TarifParKg) + Number(supplement));
            const montantArrondi = Math.ceil(montant / 1000) * 1000;
            tarifEstime.innerHTML = `<span class="text-primary fw-bold font-monospace fs-5">${montantArrondi.toLocaleString('fr-FR')} FC</span>`;
            detailTarif.textContent = `${poids.toLocaleString('fr-FR')} kg · ${(destinationInput?.value || '').trim() || 'Destination standard'}`;
        }

        if (destinationInput) destinationInput.addEventListener('input', calculerTarif);
        if (poidsInput) poidsInput.addEventListener('input', calculerTarif);
        calculerTarif();
    </script>
}
