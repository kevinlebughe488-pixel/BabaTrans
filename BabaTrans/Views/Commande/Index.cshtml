@model IEnumerable<BabaTrans.Models.Commande>
@inject BabaTrans.Services.TarificationService Tarification
@{
    ViewData["Title"] = "Gestion des Commandes";
    var estClient = User.IsInRole("Client");
    var estPersonnel = User.EstPersonnel();
}

<div class="bt-page-header">
    <div>
        @if (estClient)
        {
            <h4 class="fw-bold text-heading"><i class="bi bi-bag-check-fill text-primary me-2"></i>Mes commandes</h4>
            <div class="text-muted small">Suivi de vos expéditions déposées auprès de BABA-Trans</div>
        }
        else
        {
            <h4 class="fw-bold text-heading"><i class="bi bi-box-seam text-primary me-2"></i>Commandes des supermarchés</h4>
            <div class="text-muted small">Expéditions de marchandises vers les villes de la RDC</div>
        }
    </div>
    <a asp-action="Create" class="bt-btn bt-btn-primary">
        <i class="bi bi-plus-lg"></i> Déposer une commande
    </a>
</div>

<div class="bt-card fade-in">
    <div class="bt-card-body p-0">
        <div class="table-responsive">
            <table class="bt-table">
                <thead>
                    <tr>
                        <th>N° Commande</th>
                        @if (!estClient)
                        {
                            <th>Supermarché</th>
                        }
                        <th>Destination</th>
                        <th>Distance</th>
                        <th>Colis</th>
                        <th>Tarif</th>
                        <th>Date</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var cmd in Model)
                        {
                            var estimation = Tarification.Calculer(cmd);
                            <tr>
                                <td class="fw-bold text-heading">CMD-@cmd.Id</td>
                                @if (!estClient)
                                {
                                    <td>
                                        <div class="fw-semibold text-heading">@(cmd.Client?.NomSupermarche ?? "Inconnu")</div>
                                        <div class="text-muted small">@cmd.Client?.Telephone</div>
                                    </td>
                                }
                                <td>
                                    <span class="text-heading"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@cmd.VilleDestination</span>
                                </td>
                                <td class="text-nowrap">
                                    @if (cmd.DistanceKm.HasValue)
                                    {
                                        <span class="text-heading">@cmd.DistanceKm.Value.ToString("N1") km</span>
                                        <div class="text-muted small">≈ @CarteHelper.Duree(cmd.DureeEstimeeMinutes)</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Non localisée</span>
                                    }
                                </td>
                                <td>
                                    <span class="bt-badge bt-badge-neutral">@cmd.Colis.Count colis</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-primary-bt">@estimation.Total.ToString("N0") FC</span>
                                    <div class="text-muted small">@(estimation.PoidsReel ? "poids réel" : "estimation")</div>
                                </td>
                                <td>@cmd.DateCommande.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="bt-badge @cmd.Statut.Badge()">@cmd.Statut.Libelle()</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@cmd.Id" class="bt-btn bt-btn-outline bt-btn-sm" title="Détails">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (estPersonnel && cmd.Statut.EstOuverte())
                                        {
                                            <a asp-action="Edit" asp-route-id="@cmd.Id" class="bt-btn bt-btn-outline bt-btn-sm" title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-controller="Colis" asp-action="Create" asp-route-commandeId="@cmd.Id" class="bt-btn bt-btn-primary bt-btn-sm" title="Ajouter un colis à cette commande">
                                                <i class="bi bi-plus-square"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(estClient ? 8 : 9)">
                                <div class="bt-empty-state">
                                    <i class="bi bi-box-seam"></i>
                                    <h5>Aucune commande enregistrée</h5>
                                    <p>Déposez une première commande pour lancer le processus de livraison.</p>
                                    <a asp-action="Create" class="bt-btn bt-btn-primary bt-btn-sm">
                                        <i class="bi bi-plus-lg"></i> Déposer une commande
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
