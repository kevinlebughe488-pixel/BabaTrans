@model BabaTrans.Models.Commande
@inject BabaTrans.Services.TarificationService Tarification
@{
    ViewData["Title"] = "Commande CMD-" + Model.Id;
    var estPersonnel = User.EstPersonnel();
    var colisAvecTimbre = ViewBag.ColisAvecTimbre as HashSet<int> ?? new HashSet<int>();
    var peutAnnuler = ViewBag.PeutAnnuler == true;
    var estimation = Tarification.Calculer(Model);
    var aDesInfosDestination = !string.IsNullOrEmpty(Model.AdresseDestination) || !string.IsNullOrEmpty(Model.QuartierDestination)
        || !string.IsNullOrEmpty(Model.ContactDestination) || !string.IsNullOrEmpty(Model.TelephoneDestination);
}

<div class="bt-page-header">
    <div>
        <h4 class="fw-bold text-heading">
            <i class="bi bi-box-seam text-primary me-2"></i>Commande CMD-@Model.Id
            <span class="bt-badge @Model.Statut.Badge() ms-2 align-middle">@Model.Statut.Libelle()</span>
        </h4>
        <div class="text-muted small">Créée le @Model.DateCommande.ToString("dd MMMM yyyy 'à' HH:mm")</div>
    </div>
    <div class="bt-page-actions">
        @if (estPersonnel && Model.Statut.EstOuverte())
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-pencil"></i> Modifier</a>
            <a asp-controller="Colis" asp-action="Create" asp-route-commandeId="@Model.Id" class="bt-btn bt-btn-primary bt-btn-sm"><i class="bi bi-plus-lg"></i> Ajouter un colis</a>
        }
        @if (peutAnnuler)
        {
            <form asp-action="Annuler" asp-route-id="@Model.Id" method="post" data-confirm="Annuler définitivement la commande CMD-@Model.Id ?">
                <button type="submit" class="bt-btn bt-btn-outline bt-btn-sm text-danger"><i class="bi bi-x-circle"></i> Annuler la commande</button>
            </form>
        }
        <a asp-action="Index" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-arrow-left"></i> Retour</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="bt-card h-100">
            <div class="bt-card-header">
                <h5><i class="bi bi-shop text-primary me-2"></i>Supermarché expéditeur</h5>
            </div>
            <div class="bt-card-body">
                <dl class="row bt-dl">
                    <dt class="col-sm-5">Nom</dt>
                    <dd class="col-sm-7 fw-bold">@(Model.Client?.NomSupermarche ?? "Inconnu")</dd>

                    <dt class="col-sm-5">Adresse</dt>
                    <dd class="col-sm-7">@(Model.Client?.Adresse ?? "—")</dd>

                    <dt class="col-sm-5">Téléphone</dt>
                    <dd class="col-sm-7">@(Model.Client?.Telephone ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="bt-card h-100">
            <div class="bt-card-header">
                <h5><i class="bi bi-geo-alt-fill text-danger me-2"></i>Destination</h5>
            </div>
            <div class="bt-card-body">
                <dl class="row bt-dl">
                    <dt class="col-sm-5">Ville</dt>
                    <dd class="col-sm-7 fw-bold">@Model.VilleDestination</dd>

                    @if (aDesInfosDestination)
                    {
                        <dt class="col-sm-5">Adresse</dt>
                        <dd class="col-sm-7">
                            @(Model.AdresseDestination ?? "—")
                            @if (!string.IsNullOrEmpty(Model.QuartierDestination))
                            {
                                <span class="text-muted">(@Model.QuartierDestination)</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Destinataire</dt>
                        <dd class="col-sm-7">
                            @(Model.ContactDestination ?? "—")
                            @if (!string.IsNullOrEmpty(Model.TelephoneDestination))
                            {
                                <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@Model.TelephoneDestination</div>
                            }
                        </dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <dt class="col-sm-5">Instructions</dt>
                        <dd class="col-sm-7">@Model.Description</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="bt-card h-100">
            <div class="bt-card-header">
                <h5><i class="bi bi-signpost-split text-primary me-2"></i>Trajet & moyen de transport</h5>
            </div>
            <div class="bt-card-body">
                @if (Model.Trajet != null)
                {
                    <dl class="row bt-dl">
                        <dt class="col-sm-5">Itinéraire</dt>
                        <dd class="col-sm-7 fw-bold">@Model.Trajet.VilleDepart → @Model.Trajet.VilleArrivee</dd>

                        <dt class="col-sm-5">Distance</dt>
                        <dd class="col-sm-7">@(Model.Trajet.DistanceKm.HasValue ? $"{Model.Trajet.DistanceKm:N0} km" : "Non spécifiée")</dd>

                        <dt class="col-sm-5">Durée estimée</dt>
                        <dd class="col-sm-7">@(Model.Trajet.DureeEstimeeHeures.HasValue ? $"{Model.Trajet.DureeEstimeeHeures} h" : "Non spécifiée")</dd>

                        @if (estPersonnel)
                        {
                            <dt class="col-sm-5">Véhicule habituel</dt>
                            <dd class="col-sm-7">
                                @if (Model.Trajet.MoyenTransport != null)
                                {
                                    <span class="bt-badge bt-badge-neutral">
                                        <i class="bi bi-truck"></i>@Model.Trajet.MoyenTransport.Type · @Model.Trajet.MoyenTransport.Capacite.ToString("N0") kg
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">Aucun véhicule assigné</span>
                                }
                            </dd>
                        }
                    </dl>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-signpost-split fs-2 d-block mb-2"></i>
                        Aucun trajet affecté pour l'instant.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="bt-card h-100">
            <div class="bt-card-header">
                <h5><i class="bi bi-receipt text-warning me-2"></i>Tarif</h5>
                <span class="bt-badge @(estimation.PoidsReel ? "bt-badge-accent" : "bt-badge-warning")">
                    @(estimation.PoidsReel ? "Poids réel des colis" : "Sur poids estimé")
                </span>
            </div>
            <div class="bt-card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-6">
                        <div class="text-muted small text-uppercase">Poids</div>
                        <div class="fs-5 fw-bold text-heading">@estimation.PoidsTotalKg.ToString("N2") kg</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small text-uppercase">Forfait + destination</div>
                        <div class="text-heading">@((estimation.ForfaitBase + estimation.SupplementDestination).ToString("N0")) FC</div>
                    </div>
                    <div class="col-12">
                        <div class="bt-panel d-flex justify-content-between align-items-center">
                            <span class="text-muted small text-uppercase fw-semibold">Montant</span>
                            <span class="fs-4 fw-bold text-primary-bt">@estimation.Total.ToString("N0") FC</span>
                        </div>
                    </div>
                </div>
                <div class="text-muted small mt-3">
                    @(estimation.PoidsReel
                        ? "Calculé sur le poids total des colis enregistrés."
                        : "Estimation sur le poids déclaré : elle sera recalculée dès l'enregistrement des colis.")
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Colis de la commande -->
<div class="bt-card">
    <div class="bt-card-header">
        <h5><i class="bi bi-boxes text-warning me-2"></i>Colis de cette commande (@Model.Colis.Count)</h5>
    </div>
    <div class="bt-card-body p-0">
        <div class="table-responsive">
            <table class="bt-table">
                <thead>
                    <tr>
                        <th>N° Colis</th>
                        <th>Code de suivi</th>
                        <th>Description</th>
                        <th>Poids</th>
                        <th>Timbre QR</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Colis.Any())
                    {
                        foreach (var colis in Model.Colis.OrderBy(c => c.Id))
                        {
                            <tr>
                                <td class="fw-bold text-heading">#@colis.Id</td>
                                <td><span class="bt-code">@colis.CodeSuivi</span></td>
                                <td>@colis.Description</td>
                                <td class="text-nowrap">@colis.Poids kg</td>
                                <td>
                                    @if (colisAvecTimbre.Contains(colis.Id))
                                    {
                                        <span class="bt-badge bt-badge-accent"><i class="bi bi-qr-code"></i> Actif</span>
                                    }
                                    else
                                    {
                                        <span class="bt-badge bt-badge-warning">Non généré</span>
                                    }
                                </td>
                                <td>
                                    <span class="bt-badge @colis.Statut.Badge()">@colis.Statut.Libelle()</span>
                                </td>
                                <td class="text-end">
                                    @if (estPersonnel)
                                    {
                                        <a asp-controller="Colis" asp-action="Details" asp-route-id="@colis.Id" class="bt-btn bt-btn-outline bt-btn-sm">
                                            <i class="bi bi-eye"></i> Fiche & timbre
                                        </a>
                                    }
                                    else if (!string.IsNullOrEmpty(colis.CodeSuivi))
                                    {
                                        <a asp-controller="Colis" asp-action="Suivi" asp-route-code="@colis.CodeSuivi" class="bt-btn bt-btn-outline bt-btn-sm">
                                            <i class="bi bi-search"></i> Suivre
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                @if (estPersonnel && Model.Statut.EstOuverte())
                                {
                                    <span>Aucun colis pour le moment. Utilisez « Ajouter un colis » pour enregistrer les marchandises.</span>
                                }
                                else
                                {
                                    <span>Aucun colis enregistré pour cette commande.</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
