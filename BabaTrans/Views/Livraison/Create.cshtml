@model BabaTrans.Models.Livraison
@{
    ViewData["Title"] = "Affecter une Livraison";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="bt-card fade-in">
            <div class="bt-card-header">
                <h5><i class="bi bi-person-badge text-primary me-2"></i>Affectation Colis & Livreur (Diagramme de Séquence)</h5>
                <a asp-action="Index" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-arrow-left"></i> Retour</a>
            </div>
            <div class="bt-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="bt-alert bt-alert-danger mb-4"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="ColisId" class="bt-form-label">Colis à Expédier</label>
                            <select asp-for="ColisId" class="bt-form-control" asp-items="ViewBag.Colis">
                                <option value="">-- Sélectionnez un colis prêt --</option>
                            </select>
                            <span asp-validation-for="ColisId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LivreurId" class="bt-form-label">Livreur Assigné</label>
                            <select asp-for="LivreurId" class="bt-form-control" asp-items="ViewBag.Livreurs">
                                <option value="">-- Sélectionnez le livreur responsable --</option>
                            </select>
                            <span asp-validation-for="LivreurId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MoyenTransportId" class="bt-form-label"><i class="bi bi-truck me-1"></i>Moyen de Transport</label>
                            <select asp-for="MoyenTransportId" class="bt-form-control" asp-items="ViewBag.MoyensTransport">
                                <option value="">-- Sélectionnez le véhicule --</option>
                            </select>
                            <span asp-validation-for="MoyenTransportId" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Commentaire" class="bt-form-label">Notes de livraison (Optionnel)</label>
                            <textarea asp-for="Commentaire" class="bt-form-control" rows="2" placeholder="Précisions de contact pour la remise, heure souhaitée, etc."></textarea>
                            <span asp-validation-for="Commentaire" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top border-secondary-subtle">
                        <a asp-action="Index" class="bt-btn bt-btn-outline">Annuler</a>
                        <button type="submit" class="bt-btn bt-btn-primary">
                            <i class="bi bi-check-circle"></i> Valider l'affectation
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
