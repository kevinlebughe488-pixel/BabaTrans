@model IEnumerable<BabaTrans.Models.Livraison>
@{
    var estPersonnel = User.EstPersonnel();
    ViewData["Title"] = estPersonnel ? "Gestion des Livraisons & Tournées" : "Mes livraisons";
}

<div class="bt-page-header">
    <div>
        <h4 class="fw-bold text-heading">
            <i class="bi bi-send-check text-primary me-2"></i>@(estPersonnel ? "Expéditions & livraisons" : "Mes livraisons")
        </h4>
        <div class="text-muted small">
            @(estPersonnel
                ? "Affectation des livreurs, scans au départ et confirmations à l'arrivée"
                : "Vos tournées : scannez au départ, à l'arrivée, puis confirmez la remise")
        </div>
    </div>
    @if (estPersonnel)
    {
        <div class="bt-page-actions">
            <a asp-controller="SuiviGps" asp-action="Carte" class="bt-btn bt-btn-outline">
                <i class="bi bi-broadcast-pin"></i> Carte en direct
            </a>
            <a asp-action="Create" class="bt-btn bt-btn-primary">
                <i class="bi bi-plus-lg"></i> Affecter une livraison
            </a>
        </div>
    }
</div>

<div class="bt-card fade-in">
    <div class="bt-card-body p-0">
        <div class="table-responsive">
            <table class="bt-table">
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Colis</th>
                        <th class="text-wrap">Supermarché&nbsp;& destination</th>
                        <th>@(estPersonnel ? "Livreur & véhicule" : "Véhicule")</th>
                        <th>Départ / arrivée</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var liv in Model)
                        {
                            <tr>
                                <td class="fw-bold text-heading">#@liv.Id</td>
                                <td>
                                    @* Sur téléphone, le tableau défile : le colis mène directement à la livraison et montre son statut. *@
                                    <a asp-action="Details" asp-route-id="@liv.Id" class="fw-semibold text-decoration-none">Colis #@liv.ColisId</a>
                                    <div><span class="bt-code">@liv.Colis?.CodeSuivi</span></div>
                                    <span class="bt-badge @liv.Statut.Badge() d-md-none mt-1">@liv.Statut.Libelle()</span>
                                </td>
                                <td>
                                    <div class="text-heading">@(liv.Colis?.Commande?.Client?.NomSupermarche ?? "Inconnu")</div>
                                    <div class="text-muted small"><i class="bi bi-geo-alt text-danger me-1"></i>@(liv.Colis?.Commande?.VilleDestination ?? "—")</div>
                                </td>
                                <td>
                                    @if (estPersonnel)
                                    {
                                        if (liv.Livreur != null)
                                        {
                                            <div class="fw-semibold text-heading text-nowrap">@liv.Livreur.Prenom @liv.Livreur.Nom</div>
                                        }
                                        else
                                        {
                                            <div class="text-muted">Non affecté</div>
                                        }
                                        <div class="text-muted small text-nowrap">
                                            @string.Join(" · ", new[] { liv.MoyenTransport?.Type, liv.MoyenTransport?.Immatriculation }.Where(t => !string.IsNullOrEmpty(t)))
                                        </div>
                                    }
                                    else if (liv.MoyenTransport != null)
                                    {
                                        <div class="text-heading">@liv.MoyenTransport.Type</div>
                                        <div class="text-muted small font-monospace">@(liv.MoyenTransport.Immatriculation ?? "—")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <div>@(liv.DateDepart?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                                    <div class="text-muted small">@(liv.DateArrivee.HasValue ? $"arrivée {liv.DateArrivee:dd/MM HH:mm}" : "")</div>
                                </td>
                                <td>
                                    <span class="bt-badge @liv.Statut.Badge()">@liv.Statut.Libelle()</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@liv.Id" class="bt-btn @(liv.Statut is StatutLivraison.EnAttente or StatutLivraison.EnCours ? "bt-btn-primary" : "bt-btn-outline") bt-btn-sm">
                                        <i class="bi bi-qr-code-scan"></i>
                                        @(liv.Statut is StatutLivraison.EnAttente or StatutLivraison.EnCours ? "Traiter" : "Voir")
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="bt-empty-state">
                                    <i class="bi bi-send-check"></i>
                                    <h5>Aucune livraison</h5>
                                    @if (estPersonnel)
                                    {
                                        <p>Affectez les colis prêts à un livreur et à un véhicule pour lancer l'acheminement.</p>
                                        <a asp-action="Create" class="bt-btn bt-btn-primary bt-btn-sm">
                                            <i class="bi bi-plus-lg"></i> Affecter une livraison
                                        </a>
                                    }
                                    else
                                    {
                                        <p>Aucune tournée ne vous est affectée pour le moment.</p>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
