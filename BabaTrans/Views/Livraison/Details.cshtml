@model BabaTrans.Models.Livraison
@{
    ViewData["Title"] = "Livraison #" + Model.Id;
    var enAttente = Model.Statut == StatutLivraison.EnAttente;
    var enCours = Model.Statut == StatutLivraison.EnCours;
    var commande = Model.Colis?.Commande;
}

<div class="bt-page-header">
    <div>
        <h4 class="fw-bold text-heading">
            <i class="bi bi-send-check-fill text-primary me-2"></i>Livraison #@Model.Id
            <span class="bt-badge @Model.Statut.Badge() ms-2 align-middle">@Model.Statut.Libelle()</span>
        </h4>
        <div class="text-muted small">Colis #@Model.ColisId · <span class="bt-code">@Model.Colis?.CodeSuivi</span></div>
    </div>
    <div class="bt-page-actions">
        @if (enAttente || enCours)
        {
            <button type="button" class="bt-btn bt-btn-outline bt-btn-sm text-danger" data-bs-toggle="modal" data-bs-target="#echecModal">
                <i class="bi bi-exclamation-octagon"></i> Déclarer un échec
            </button>
        }
        <a asp-action="Index" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-arrow-left"></i> Liste des livraisons</a>
    </div>
</div>

@if (Model.Statut == StatutLivraison.Echouee)
{
    <div class="bt-alert bt-alert-danger">
        <i class="bi bi-x-octagon-fill fs-5"></i>
        <div>Cette livraison a échoué. Le colis est revenu au dépôt et peut être réaffecté à une nouvelle livraison.</div>
    </div>
}

<!-- Étapes opérationnelles -->
<div class="bt-card mb-4">
    <div class="bt-card-header">
        <h5><i class="bi bi-play-circle-fill text-primary me-2"></i>Étapes de la livraison</h5>
    </div>
    <div class="bt-card-body">
        <div class="row g-3">
            <!-- 1. Scan départ -->
            <div class="col-md-4">
                <div class="bt-panel text-center h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="fw-bold text-heading mb-1"><i class="bi bi-upc-scan text-warning me-1"></i> 1. Scan départ</div>
                        <p class="text-muted small mb-2">Prise en charge au dépôt BABA-Trans.</p>
                        @if (Model.DateDepart.HasValue)
                        {
                            <span class="bt-badge bt-badge-accent mb-2">
                                <i class="bi bi-check2"></i> Le @Model.DateDepart.Value.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        }
                    </div>
                    @if (enAttente)
                    {
                        <form asp-action="ScannerDepart" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="bt-btn bt-btn-warning w-100 justify-content-center bt-btn-sm">
                                <i class="bi bi-camera"></i> Valider le scan de départ
                            </button>
                        </form>
                    }
                </div>
            </div>

            <!-- 2. Scan arrivée -->
            <div class="col-md-4">
                <div class="bt-panel text-center h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="fw-bold text-heading mb-1"><i class="bi bi-geo-alt text-primary me-1"></i> 2. Scan arrivée</div>
                        <p class="text-muted small mb-2">Arrivée dans la ville de destination.</p>
                        @if (Model.DateArrivee.HasValue)
                        {
                            <span class="bt-badge bt-badge-accent mb-2">
                                <i class="bi bi-check2"></i> Le @Model.DateArrivee.Value.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        }
                    </div>
                    @if (enCours && !Model.DateArrivee.HasValue)
                    {
                        <form asp-action="ScannerArrivee" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="bt-btn bt-btn-primary w-100 justify-content-center bt-btn-sm">
                                <i class="bi bi-camera"></i> Valider le scan d'arrivée
                            </button>
                        </form>
                    }
                </div>
            </div>

            <!-- 3. Confirmation -->
            <div class="col-md-4">
                <div class="bt-panel text-center h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="fw-bold text-heading mb-1"><i class="bi bi-patch-check text-success me-1"></i> 3. Remise confirmée</div>
                        <p class="text-muted small mb-2">Remise au destinataire, avec le nom du signataire.</p>
                        @if (Model.DateLivraison.HasValue)
                        {
                            <span class="bt-badge bt-badge-accent mb-2">
                                <i class="bi bi-check-all"></i> Le @Model.DateLivraison.Value.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        }
                    </div>
                    @if (enCours && Model.DateArrivee.HasValue)
                    {
                        <button type="button" class="bt-btn bt-btn-accent w-100 justify-content-center bt-btn-sm" data-bs-toggle="modal" data-bs-target="#confirmModal">
                            <i class="bi bi-pen"></i> Confirmer la remise
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Suivi GPS du livreur en temps réel -->
<partial name="_SuiviGps" model="Model" />

<div class="row g-4">
    <!-- Colis, timbre et adresse de livraison -->
    <div class="col-md-6">
        <div class="bt-card h-100">
            <div class="bt-card-header">
                <h5>Colis & destination</h5>
                @if (User.EstPersonnel())
                {
                    <a asp-controller="Colis" asp-action="Details" asp-route-id="@Model.ColisId" class="bt-btn bt-btn-outline bt-btn-sm">Fiche colis</a>
                }
                else if (!string.IsNullOrEmpty(Model.Colis?.CodeSuivi))
                {
                    <a asp-controller="Colis" asp-action="Suivi" asp-route-code="@Model.Colis.CodeSuivi" class="bt-btn bt-btn-outline bt-btn-sm">Suivi</a>
                }
            </div>
            <div class="bt-card-body">
                @if (Model.Colis != null)
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(Model.Colis.TimbreQRCode?.ImageBase64))
                        {
                            <div class="bt-qr-code p-2">
                                <img src="data:image/png;base64,@Model.Colis.TimbreQRCode.ImageBase64" alt="QR du colis" style="width: 80px; height: 80px;" />
                            </div>
                        }
                        <div>
                            <div class="fw-semibold text-heading">@Model.Colis.Description</div>
                            <div class="text-muted small">Poids : @Model.Colis.Poids kg</div>
                            <span class="bt-badge @Model.Colis.Statut.Badge() mt-1">@Model.Colis.Statut.Libelle()</span>
                        </div>
                    </div>

                    <dl class="row bt-dl small">
                        <dt class="col-sm-5">Expéditeur</dt>
                        <dd class="col-sm-7 fw-semibold">@(commande?.Client?.NomSupermarche ?? "Inconnu")</dd>

                        <dt class="col-sm-5">Ville de destination</dt>
                        <dd class="col-sm-7"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@(commande?.VilleDestination ?? "—")</dd>

                        <dt class="col-sm-5">Adresse de livraison</dt>
                        <dd class="col-sm-7">
                            @(commande?.AdresseDestination ?? "Non précisée")
                            @if (!string.IsNullOrEmpty(commande?.QuartierDestination))
                            {
                                <span class="text-muted">(@commande.QuartierDestination)</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Destinataire</dt>
                        <dd class="col-sm-7">
                            @(commande?.ContactDestination ?? "Non précisé")
                            @if (!string.IsNullOrEmpty(commande?.TelephoneDestination))
                            {
                                <div><a href="tel:@commande.TelephoneDestination" class="text-decoration-none"><i class="bi bi-telephone me-1"></i>@commande.TelephoneDestination</a></div>
                            }
                        </dd>

                        @if (!string.IsNullOrEmpty(commande?.Description))
                        {
                            <dt class="col-sm-5">Instructions</dt>
                            <dd class="col-sm-7">@commande.Description</dd>
                        }
                    </dl>
                }
            </div>
        </div>
    </div>

    <!-- Livreur et véhicule -->
    <div class="col-md-6">
        <div class="bt-card h-100">
            <div class="bt-card-header">
                <h5>Livreur & véhicule</h5>
            </div>
            <div class="bt-card-body">
                @if (Model.Livreur != null)
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bt-avatar bt-avatar-lg">
                            @($"{Model.Livreur.Prenom.FirstOrDefault()}{Model.Livreur.Nom.FirstOrDefault()}".ToUpper())
                        </div>
                        <div>
                            <h6 class="fw-bold text-heading mb-0">@Model.Livreur.Prenom @Model.Livreur.Nom</h6>
                            <div class="text-muted small">@Model.Livreur.Email</div>
                            @if (!string.IsNullOrEmpty(Model.Livreur.Immatriculation))
                            {
                                <span class="bt-code">@Model.Livreur.Immatriculation</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted">Aucun livreur assigné.</div>
                }

                <hr class="my-3" />

                @if (Model.MoyenTransport != null)
                {
                    <dl class="row bt-dl small">
                        <dt class="col-sm-5">Véhicule</dt>
                        <dd class="col-sm-7 fw-semibold">@Model.MoyenTransport.Type</dd>

                        <dt class="col-sm-5">Immatriculation</dt>
                        <dd class="col-sm-7">@(Model.MoyenTransport.Immatriculation ?? "—")</dd>

                        <dt class="col-sm-5">Capacité</dt>
                        <dd class="col-sm-7">@Model.MoyenTransport.Capacite.ToString("N0") kg</dd>
                    </dl>
                }
                else
                {
                    <div class="text-center py-2 text-muted small">
                        <i class="bi bi-exclamation-triangle me-1"></i>Aucun véhicule affecté.
                    </div>
                }

                <hr class="my-3" />

                <h6 class="text-uppercase text-muted small fw-bold mb-2">Notes & historique</h6>
                @if (string.IsNullOrWhiteSpace(Model.Commentaire))
                {
                    <div class="text-muted small fst-italic">Aucune note.</div>
                }
                else
                {
                    <div class="bt-panel small" style="white-space: pre-line;">@Model.Commentaire</div>
                }
            </div>
        </div>
    </div>
</div>

@if (enCours && Model.DateArrivee.HasValue)
{
    <!-- Confirmation de remise -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalTitre" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Confirmer" asp-route-id="@Model.Id" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="confirmModalTitre"><i class="bi bi-patch-check-fill text-success me-2"></i>Confirmer la remise</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small">
                            En confirmant, vous attestez que le colis a été remis conforme au destinataire.
                        </p>
                        <label for="commentaire" class="bt-form-label">Nom du signataire et remarques</label>
                        <input type="text" id="commentaire" name="commentaire" class="bt-form-control" required maxlength="200"
                               placeholder="Ex : réceptionné sans dommage par M. Paul, gérant" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="bt-btn bt-btn-outline" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="bt-btn bt-btn-accent">Confirmer définitivement</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (enAttente || enCours)
{
    <!-- Déclaration d'échec -->
    <div class="modal fade" id="echecModal" tabindex="-1" aria-labelledby="echecModalTitre" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Echec" asp-route-id="@Model.Id" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="echecModalTitre"><i class="bi bi-exclamation-octagon-fill text-danger me-2"></i>Déclarer un échec</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small">
                            La livraison sera clôturée en échec. Le colis reviendra au dépôt et pourra être réaffecté.
                        </p>
                        <label for="motif" class="bt-form-label">Motif</label>
                        <input type="text" id="motif" name="motif" class="bt-form-control" required maxlength="200"
                               placeholder="Ex : destinataire absent, route impraticable, colis endommagé" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="bt-btn bt-btn-outline" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="bt-btn bt-btn-danger">Enregistrer l'échec</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_CarteScripts" />
}
