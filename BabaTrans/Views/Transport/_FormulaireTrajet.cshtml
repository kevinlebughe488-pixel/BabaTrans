@model BabaTrans.Models.Trajet
@* Champs communs aux formulaires de création et de modification d'un trajet *@

<div class="col-md-6">
    <label asp-for="VilleDepart" class="bt-form-label"></label>
    <input asp-for="VilleDepart" class="bt-form-control" placeholder="Ex : Kinshasa" />
    <span asp-validation-for="VilleDepart" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="VilleArrivee" class="bt-form-label"></label>
    <input asp-for="VilleArrivee" class="bt-form-control" placeholder="Ex : Matadi" />
    <span asp-validation-for="VilleArrivee" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="DistanceKm" class="bt-form-label">Distance</label>
    <div class="input-group">
        <input asp-for="DistanceKm" class="bt-form-control" type="number" min="1" max="10000" step="1" placeholder="Ex : 350" />
        <span class="input-group-text">km</span>
    </div>
    <span asp-validation-for="DistanceKm" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="DureeEstimeeHeures" class="bt-form-label">Durée estimée</label>
    <div class="input-group">
        <input asp-for="DureeEstimeeHeures" class="bt-form-control" type="number" min="0.5" max="500" step="0.5" placeholder="Ex : 6.5" />
        <span class="input-group-text">h</span>
    </div>
    <span asp-validation-for="DureeEstimeeHeures" class="text-danger small"></span>
</div>

<div class="col-md-12">
    <label asp-for="MoyenTransportId" class="bt-form-label">Véhicule habituel</label>
    <select asp-for="MoyenTransportId" class="bt-form-control" asp-items="ViewBag.MoyensTransport">
        <option value="">-- Aucun véhicule assigné --</option>
    </select>
    <span asp-validation-for="MoyenTransportId" class="text-danger small"></span>
</div>
