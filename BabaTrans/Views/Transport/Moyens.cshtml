@model IEnumerable<BabaTrans.Models.MoyenTransport>
@{
    ViewData["Title"] = "Moyens de Transport";
    var engages = ViewBag.VehiculesEngages as HashSet<int> ?? new HashSet<int>();
}

<div class="bt-page-header">
    <div>
        <h4 class="fw-bold text-heading"><i class="bi bi-truck-front-fill text-primary me-2"></i>Flotte & véhicules</h4>
        <div class="text-muted small">Camions, camionnettes et motos du réseau inter-villes et urbain</div>
    </div>
    <div class="bt-page-actions">
        <a asp-action="Trajets" class="bt-btn bt-btn-outline">
            <i class="bi bi-geo-alt"></i> Voir les trajets
        </a>
        <a asp-action="CreateMoyen" class="bt-btn bt-btn-primary">
            <i class="bi bi-plus-lg"></i> Nouveau véhicule
        </a>
    </div>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var m in Model)
        {
            <div class="col-md-6 col-xl-3">
                <div class="bt-card h-100 d-flex flex-column">
                    <div class="bt-card-header">
                        <div class="d-flex align-items-center gap-2 overflow-hidden">
                            <i class="bi bi-truck fs-5 text-primary"></i>
                            <h5 class="mb-0 text-truncate">@m.Type</h5>
                        </div>
                        @if (!m.EstDisponible)
                        {
                            <span class="bt-badge bt-badge-danger">Indisponible</span>
                        }
                        else if (engages.Contains(m.Id))
                        {
                            <span class="bt-badge bt-badge-orange">En mission</span>
                        }
                        else
                        {
                            <span class="bt-badge bt-badge-accent">Disponible</span>
                        }
                    </div>
                    <div class="bt-card-body flex-grow-1">
                        <div class="mb-3">
                            <div class="text-muted small text-uppercase">Capacité maximale</div>
                            <div class="fs-4 fw-bold text-heading">@m.Capacite.ToString("N0") <span class="fs-6 text-muted">kg</span></div>
                        </div>
                        <div class="mb-3">
                            <div class="text-muted small text-uppercase mb-1">Immatriculation</div>
                            @if (!string.IsNullOrEmpty(m.Immatriculation))
                            {
                                <span class="bt-code">@m.Immatriculation</span>
                            }
                            else
                            {
                                <span class="text-muted small">Non renseignée</span>
                            }
                        </div>
                        <div class="text-muted small">
                            @(m.Description ?? "Véhicule de la flotte BABA-Trans.")
                        </div>
                        @if (m.Trajets.Any())
                        {
                            <div class="text-muted small mt-2">
                                <i class="bi bi-signpost-split me-1"></i>Véhicule habituel de @m.Trajets.Count trajet@(m.Trajets.Count > 1 ? "s" : "")
                            </div>
                        }
                    </div>
                    <div class="p-3 border-top text-end">
                        <a asp-action="EditMoyen" asp-route-id="@m.Id" class="bt-btn bt-btn-outline bt-btn-sm">
                            <i class="bi bi-pencil"></i> Modifier
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="bt-card">
        <div class="bt-empty-state">
            <i class="bi bi-truck"></i>
            <h5>Aucun véhicule enregistré</h5>
            <p>Ajoutez les véhicules de la flotte pour pouvoir affecter les livraisons.</p>
            <a asp-action="CreateMoyen" class="bt-btn bt-btn-primary bt-btn-sm">
                <i class="bi bi-plus-lg"></i> Ajouter un véhicule
            </a>
        </div>
    </div>
}
