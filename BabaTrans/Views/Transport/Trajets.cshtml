@model IEnumerable<BabaTrans.Models.Trajet>
@{
    ViewData["Title"] = "Trajets Inter-Villes";
}

<div class="bt-page-header">
    <div>
        <h4 class="fw-bold text-heading"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Lignes & trajets inter-villes</h4>
        <div class="text-muted small">Réseau d'acheminement à travers la République Démocratique du Congo</div>
    </div>
    <div class="bt-page-actions">
        <a asp-action="Moyens" class="bt-btn bt-btn-outline">
            <i class="bi bi-truck"></i> Gérer la flotte
        </a>
        <a asp-action="CreateTrajet" class="bt-btn bt-btn-primary">
            <i class="bi bi-plus-lg"></i> Nouveau trajet
        </a>
    </div>
</div>

<div class="bt-card fade-in">
    <div class="bt-card-body p-0">
        <div class="table-responsive">
            <table class="bt-table">
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Itinéraire</th>
                        <th>Distance</th>
                        <th>Durée estimée</th>
                        <th>Véhicule habituel</th>
                        <th>Commandes</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var t in Model)
                        {
                            <tr>
                                <td class="fw-bold text-heading">#@t.Id</td>
                                <td>
                                    <span class="fw-bold text-heading">@t.VilleDepart</span>
                                    <i class="bi bi-arrow-right mx-2 text-primary"></i>
                                    <span class="fw-bold text-heading">@t.VilleArrivee</span>
                                </td>
                                <td class="text-nowrap">@(t.DistanceKm.HasValue ? $"{t.DistanceKm:N0} km" : "—")</td>
                                <td class="text-nowrap">@(t.DureeEstimeeHeures.HasValue ? $"{t.DureeEstimeeHeures} h" : "—")</td>
                                <td>
                                    @if (t.MoyenTransport != null)
                                    {
                                        <span class="bt-badge @(t.MoyenTransport.EstDisponible ? "bt-badge-neutral" : "bt-badge-danger")">
                                            <i class="bi bi-truck"></i>@t.MoyenTransport.Type · @t.MoyenTransport.Capacite.ToString("N0") kg
                                            @(t.MoyenTransport.EstDisponible ? "" : "(indisponible)")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Non affecté</span>
                                    }
                                </td>
                                <td>
                                    <span class="bt-badge bt-badge-neutral">@t.Commandes.Count</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="EditTrajet" asp-route-id="@t.Id" class="bt-btn bt-btn-outline bt-btn-sm">
                                        <i class="bi bi-pencil"></i> Modifier
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="bt-empty-state">
                                    <i class="bi bi-geo-alt"></i>
                                    <h5>Aucun trajet configuré</h5>
                                    <p>Définissez les axes principaux (ex : Kinshasa → Matadi, Kinshasa → Lubumbashi).</p>
                                    <a asp-action="CreateTrajet" class="bt-btn bt-btn-primary bt-btn-sm">
                                        <i class="bi bi-plus-lg"></i> Ajouter un trajet
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
