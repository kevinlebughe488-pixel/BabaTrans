@model IEnumerable<BabaTrans.Models.Trajet>
@{
    ViewData["Title"] = "Trajets Inter-Villes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white fw-bold mb-1"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Lignes & Trajets Inter-Villes</h4>
        <div class="text-muted small">Réseau d'acheminement à travers la République Démocratique du Congo</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Moyens" class="bt-btn bt-btn-outline">
            <i class="bi bi-truck"></i> Gérer la Flotte
        </a>
        <a asp-action="CreateTrajet" class="bt-btn bt-btn-primary">
            <i class="bi bi-plus-lg"></i> Nouveau Trajet
        </a>
    </div>
</div>

<div class="bt-card fade-in">
    <div class="bt-card-body p-0">
        <div class="table-responsive">
            <table class="bt-table">
                <thead>
                    <tr>
                        <th>N° Trajet</th>
                        <th>Itinéraire</th>
                        <th>Distance Estimée</th>
                        <th>Durée Estimée</th>
                        <th>Moyen de Transport Dédié</th>
                        <th>Commandes Associées</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var t in Model)
                        {
                            <tr>
                                <td class="fw-bold text-white">#@t.Id</td>
                                <td>
                                    <div class="fw-bold text-white fs-6">
                                        <span class="text-accent">@t.VilleDepart</span>
                                        <i class="bi bi-arrow-right mx-2 text-primary"></i>
                                        <span class="text-info">@t.VilleArrivee</span>
                                    </div>
                                </td>
                                <td>@(t.DistanceKm.HasValue ? $"{t.DistanceKm} km" : "—")</td>
                                <td>@(t.DureeEstimeeHeures.HasValue ? $"{t.DureeEstimeeHeures} heures" : "—")</td>
                                <td>
                                    @if (t.MoyenTransport != null)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="bi bi-truck me-1"></i>@t.MoyenTransport.Type (@t.MoyenTransport.Capacite kg)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Non affecté</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@(t.Commandes?.Count ?? 0)</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="EditTrajet" asp-route-id="@t.Id" class="bt-btn bt-btn-outline bt-btn-sm">
                                        <i class="bi bi-pencil"></i> Modifier
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="bt-empty-state">
                                    <i class="bi bi-geo-alt"></i>
                                    <h5>Aucun trajet configuré</h5>
                                    <p>Définissez les axes routiers et aériens majeurs (ex: Kinshasa - Matadi, Kinshasa - Lubumbashi).</p>
                                    <a asp-action="CreateTrajet" class="bt-btn bt-btn-primary bt-btn-sm">
                                        <i class="bi bi-plus-lg"></i> Ajouter un trajet
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
