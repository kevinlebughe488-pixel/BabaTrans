@model BabaTrans.Models.MoyenTransport
@{
    ViewData["Title"] = "Ajouter un Véhicule";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="bt-card fade-in">
            <div class="bt-card-header">
                <h5><i class="bi bi-truck text-primary me-2"></i>Nouveau Véhicule de Transport</h5>
                <a asp-action="Moyens" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-arrow-left"></i> Retour</a>
            </div>
            <div class="bt-card-body">
                <form asp-action="CreateMoyen" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="bt-alert bt-alert-danger mb-4"></div>

                    <div class="bt-form-group">
                        <label asp-for="Type" class="bt-form-label">Type de Véhicule</label>
                        <input asp-for="Type" class="bt-form-control" placeholder="Ex: Camion Remorque, Van Frigorifique, Moto Triporteur" />
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div class="bt-form-group">
                        <label asp-for="Immatriculation" class="bt-form-label"></label>
                        <input asp-for="Immatriculation" class="bt-form-control" placeholder="Ex: C-1234-KN" />
                        <span asp-validation-for="Immatriculation" class="text-danger"></span>
                    </div>

                    <div class="bt-form-group">
                        <label asp-for="Capacite" class="bt-form-label">Capacité (kg)</label>
                        <input asp-for="Capacite" class="bt-form-control" type="number" step="10" placeholder="Ex: 5000" />
                        <span asp-validation-for="Capacite" class="text-danger"></span>
                    </div>

                    <div class="bt-form-group">
                        <label asp-for="Description" class="bt-form-label"></label>
                        <textarea asp-for="Description" class="bt-form-control" rows="2" placeholder="Détails du véhicule"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary-subtle">
                        <a asp-action="Moyens" class="bt-btn bt-btn-outline">Annuler</a>
                        <button type="submit" class="bt-btn bt-btn-primary">
                            <i class="bi bi-plus-lg"></i> Ajouter à la flotte
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
