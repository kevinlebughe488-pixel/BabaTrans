@model BabaTrans.Models.MoyenTransport
@{
    ViewData["Title"] = "Modifier le Véhicule";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="bt-card fade-in">
            <div class="bt-card-header">
                <h5><i class="bi bi-pencil-square text-primary me-2"></i>Modifier @Model.Type</h5>
                <a asp-action="Moyens" class="bt-btn bt-btn-outline bt-btn-sm"><i class="bi bi-arrow-left"></i> Retour</a>
            </div>
            <div class="bt-card-body">
                <form asp-action="EditMoyen" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="bt-alert bt-alert-danger mb-4"></div>

                    <partial name="_FormulaireMoyen" model="Model" />

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Moyens" class="bt-btn bt-btn-outline">Annuler</a>
                        <button type="submit" class="bt-btn bt-btn-primary">
                            <i class="bi bi-save"></i> Enregistrer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
